---
import { SITE_CONFIG } from "../config/site";
---

<aside class="fixed bottom-3 left-3 right-3 z-30 md:hidden" aria-label="Quick contact shortcuts">
  <div class="nav-shell mx-auto grid max-w-sm grid-cols-2 gap-2 rounded-full p-1.5" style="background: rgba(10,17,22,.85); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(246,242,234,.14);">
    <a href={SITE_CONFIG.contact.phoneHref} class="flex min-h-[48px] items-center justify-center gap-2 rounded-full border border-white/15 text-[13px] font-bold text-ivory no-underline" aria-label="Call 211 Marketing">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
      Call
    </a>
    <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="flex min-h-[48px] items-center justify-center gap-2 rounded-full bg-ivory text-[13px] font-bold text-ink no-underline" aria-label="Chat with 211 Marketing on WhatsApp">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z" stroke-width="1.6" stroke-linejoin="round" /></svg>
      WhatsApp
    </a>
  </div>
</aside>
