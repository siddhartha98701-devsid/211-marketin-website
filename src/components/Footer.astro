---
import Logo from "./Logo.astro";
import GoogleMap from "./GoogleMap.astro";
import { SITE_CONFIG } from "../config/site";

const nav = [
  { href: "/", label: "Home" },
  { href: "/healthcare-marketing/", label: "Healthcare marketing" },
  { href: "/services/", label: "Services" },
  { href: "/nmc-guidelines-2026/", label: "NMC guidelines 2026, explained" },
  { href: "/free-nmc-check/", label: "Free NMC-aware check" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" }
];
---

<!-- Ink Navy block; primary lockup in Warm Ivory (approved colourway, p. 04) -->
<footer class="theme-navy relative z-[1] border-t border-ink/15 pb-28 md:pb-10" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="wrap flex flex-col gap-14 pt-20">
    <div class="flex flex-wrap items-end justify-between gap-10" data-reveal>
      <div class="flex max-w-xl flex-col gap-6">
        <a href="/" class="block w-fit p-1 no-underline" aria-label="211 Marketing home">
          <Logo variant="lockup" tone="ivory" width={200} />
        </a>
        <p class="h-section">Let's talk healthcare.</p>
        <p class="lead">Tea is on us. So is your first check.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/free-nmc-check/" class="btn-primary">Get my free check <span class="arrow" aria-hidden="true">→</span></a>
        <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-ghost">WhatsApp us</a>
      </div>
    </div>

    <div class="grid gap-10 border-t border-ink/10 pt-12 md:grid-cols-12" data-reveal-stagger>
      <address class="flex flex-col gap-2 not-italic md:col-span-3">
        <span class="lbl">Visit</span>
        <span class="text-[15px] leading-relaxed text-body">
          {SITE_CONFIG.name}, {SITE_CONFIG.address.formatted}
        </span>
        <span class="text-[15px] text-meta">{SITE_CONFIG.placeholders.hours}</span>
      </address>

      <div class="flex flex-col gap-2 text-[15px] md:col-span-3">
        <span class="lbl">Reach us</span>
        <a href={SITE_CONFIG.contact.phoneHref} class="link-u text-ink">Call {SITE_CONFIG.contact.whatsapp}</a>
        <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="link-u text-accent-ink">WhatsApp</a>
        <a href={SITE_CONFIG.contact.instagramHref} target="_blank" rel="noopener noreferrer" class="link-u text-accent-ink">Instagram {SITE_CONFIG.contact.instagram}</a>
        <a href={`mailto:${SITE_CONFIG.placeholders.businessEmail}`} class="link-u text-accent-ink">{SITE_CONFIG.placeholders.businessEmail}</a>
      </div>

      <nav class="flex flex-col gap-2 text-[15px] md:col-span-3" aria-label="Footer navigation">
        <span class="lbl">Pages</span>
        {nav.map((l) => <a href={l.href} class="link-u text-body">{l.label}</a>)}
      </nav>

      <div class="min-w-0 md:col-span-3">
        <GoogleMap compact />
      </div>
    </div>

    <p class="max-w-3xl text-xs leading-relaxed text-meta">
      All client strategies, digital communication and websites are developed to respect the National Medical Commission (NMC) guidelines of 6 October 2026. We do not publish patient testimonials, before/after photographs, unverifiable superlatives or promises of patient numbers.
    </p>

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-ink/10 pt-6 text-xs text-meta">
      <div class="flex items-center gap-3">
        <span>&copy; {new Date().getFullYear()} {SITE_CONFIG.legalName} · {SITE_CONFIG.slogan}</span>
      </div>
      <div class="flex items-center gap-4">
        <a href="/privacy/" class="link-u text-meta">Privacy (DPDP Act 2023)</a>
        <a href="/.well-known/security.txt" class="link-u text-meta">Security</a>
        <a href="/sitemap-index.xml" class="link-u text-meta">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
