---
export interface Props {
  className?: string;
}
const { className = "" } = Astro.props;

const checks = [
  "Credentials & registration",
  "Claims & superlatives",
  "Testimonials & patient images",
  "Offers & urgency",
  "AI-made content",
  "Google profile accuracy",
  "Website basics"
];
---

<section class={`relative overflow-hidden px-4 py-[clamp(40px,6vw,80px)] ${className}`} aria-labelledby="free-check-band-heading">
  <div class="anim-pulse pointer-events-none absolute left-1/2 top-[40%] -ml-[450px] -mt-[450px] h-[900px] w-[900px] rounded-full" style="background: radial-gradient(circle, rgba(233,184,114,.26), rgba(127,167,191,.1) 45%, transparent 65%); filter: blur(20px);" aria-hidden="true"></div>
  <div class="relative mx-auto flex max-w-[1240px] flex-wrap items-center gap-[clamp(32px,6vw,80px)] rounded-[36px] border border-white/15 px-[clamp(24px,5vw,72px)] py-[clamp(36px,6vw,88px)]" style="background: linear-gradient(180deg, rgba(20,32,41,.85), rgba(10,17,22,.9)); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);" data-reveal>
    <div class="flex flex-[1_1_380px] flex-col gap-6">
      <span class="inline-flex items-center gap-2.5 self-start rounded-full border border-amber/40 bg-amber/10 px-3.5 py-2 text-[11px] font-bold tracking-[0.18em] text-amber-light">
        <span class="dot dot-amber anim-blink" style="width:7px;height:7px" aria-hidden="true"></span>FREE · 15 POINTS · 48 HOURS
      </span>
      <h2 id="free-check-band-heading" class="h-section">Is your clinic's Instagram ready for the new NMC rules?</h2>
      <p class="lead">A free 15-point check of your Instagram, Google profile and website. One page, within 48 hours. No sales pressure.</p>
      <a href="/free-nmc-check/" class="btn-primary self-start">Get my free check <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <ul class="grid flex-[1_1_360px] grid-cols-1 gap-x-6 sm:grid-cols-2" aria-label="What we check">
      {checks.map((c) => (
        <li class="flex items-center gap-3 border-t border-white/10 py-3.5 text-sm text-sand">
          <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true" class="flex-none"><circle cx="9" cy="9" r="8.5" fill="none" stroke="#9BD3A8"></circle><path d="M5.5 9.2l2.2 2.2 4.6-4.8" fill="none" stroke="#9BD3A8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          {c}
        </li>
      ))}
    </ul>
  </div>
</section>
