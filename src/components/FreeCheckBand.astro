---
export interface Props {
  className?: string;
}
const { className = "" } = Astro.props;

const checks = [
  "Credentials & registration",
  "Claims & superlatives",
  "Testimonials & patient images",
  "Offers & urgency",
  "AI-made content",
  "Google profile accuracy",
  "Website basics"
];
---

<!-- Key call to action: Ink Navy block (Brand Guidelines p. 11) -->
<section class={`theme-navy ${className}`} aria-labelledby="free-check-band-heading">
  <div class="wrap grid items-center gap-[clamp(32px,6vw,80px)] py-[clamp(64px,8vw,112px)] lg:grid-cols-12" data-reveal>
    <div class="flex flex-col gap-6 lg:col-span-7">
      <p class="eyebrow">Free · 15 points · 48 hours</p>
      <h2 id="free-check-band-heading" class="h-section">Is your clinic's Instagram ready for the new NMC rules?</h2>
      <p class="lead max-w-[560px]">A free 15-point check of your Instagram, Google profile and website. One page, within 48 hours. No sales pressure.</p>
      <a href="/free-nmc-check/" class="btn-primary self-start">Get my free check <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <ul class="grid grid-cols-1 gap-x-6 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1" aria-label="What we check">
      {checks.map((c) => (
        <li class="flex items-center gap-3 border-t border-ink/15 py-3.5 text-[15px] text-body">
          <span class="text-accent" aria-hidden="true">—</span>
          {c}
        </li>
      ))}
    </ul>
  </div>
</section>
