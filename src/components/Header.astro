---
import Logo from "./Logo.astro";
import { SITE_CONFIG } from "../config/site";

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/healthcare-marketing/", label: "Healthcare" },
  { href: "/services/", label: "Services" },
  { href: "/nmc-guidelines-2026/", label: "NMC Guide" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" }
];
---

<!-- Ink Navy navigation bar (Brand Guidelines p. 11). Wordmark-only lockup for
     this low-height horizontal space (p. 04). -->
<header class="site-header theme-navy sticky top-0 z-40">
  <div class="mx-auto flex h-[72px] max-w-[1240px] items-center justify-between gap-4 px-5 sm:px-6">
    <a href="/" class="flex flex-none items-center py-3 no-underline" aria-label="211 Marketing home">
      <Logo variant="wordmark" tone="ivory" width={184} />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main navigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`whitespace-nowrap px-3 py-3 text-[15px] no-underline transition-colors duration-300 ${
              isActive ? "text-ink underline decoration-accent decoration-1 underline-offset-[10px]" : "text-body hover:text-ink"
            }`}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/free-nmc-check/" class="btn-primary btn-sm hidden whitespace-nowrap sm:inline-flex">
        Free NMC check
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex h-12 w-12 flex-none items-center justify-center rounded-full border border-ink/25 text-ink lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg id="hamburger-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="close-icon" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-72px)] overflow-y-auto border-t border-ink/10 lg:hidden">
    <div class="mx-auto max-w-[1240px] px-5 pb-6 pt-3 sm:px-6">
      <nav class="flex flex-col" aria-label="Mobile navigation">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class={`border-b border-ink/10 py-4 font-serif text-2xl no-underline ${isActive ? "text-ink" : "text-body"}`}
              aria-current={isActive ? "page" : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
      <div class="mt-5 grid gap-2">
        <a href="/free-nmc-check/" class="btn-primary w-full">Get a free NMC-aware check</a>
        <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-ghost w-full">
          WhatsApp us ({SITE_CONFIG.contact.whatsapp})
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    const setOpen = (open: boolean): void => {
      toggleBtn.setAttribute("aria-expanded", open.toString());
      toggleBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      mobileMenu.classList.toggle("hidden", !open);
      hamburgerIcon.classList.toggle("hidden", open);
      closeIcon.classList.toggle("hidden", !open);
    };
    const isOpen = (): boolean => toggleBtn.getAttribute("aria-expanded") === "true";

    toggleBtn.addEventListener("click", () => setOpen(!isOpen()));

    // Escape closes the menu and returns focus to the button
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        setOpen(false);
        toggleBtn.focus();
      }
    });

    // Tapping outside the header closes the menu
    document.addEventListener("click", (e) => {
      if (isOpen() && !(e.target as HTMLElement).closest("header.site-header")) setOpen(false);
    });

    // Close if the screen grows to desktop width while open
    window.matchMedia("(min-width: 1024px)").addEventListener("change", (m) => {
      if (m.matches) setOpen(false);
    });
  }
</script>
