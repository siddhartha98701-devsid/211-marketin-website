---
import Logo from "./Logo.astro";
import { SITE_CONFIG } from "../config/site";

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/healthcare-marketing/", label: "Healthcare" },
  { href: "/services/", label: "Services" },
  { href: "/nmc-guidelines-2026/", label: "NMC Guide" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" }
];
---

<header class="site-header sticky top-0 z-40 px-3 pt-3 sm:px-5 sm:pt-4">
  <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-3">
    <a href="/" class="nav-shell flex items-center rounded-full py-2 pl-2 pr-4 no-underline" aria-label="211 Marketing home">
      <Logo />
    </a>

    <nav class="nav-shell hidden items-center gap-1 rounded-full p-1.5 md:flex" aria-label="Main navigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`rounded-full px-4 py-3 text-[11px] font-bold uppercase tracking-[0.16em] no-underline transition-colors duration-300 ${
              isActive ? "bg-ivory text-ink" : "text-sand hover:bg-white/5 hover:text-ivory"
            }`}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/free-nmc-check/" class="btn-primary btn-sm hidden gap-2.5 sm:inline-flex">
        <span class="dot dot-amber anim-blink" aria-hidden="true"></span>
        Free NMC check
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="nav-shell inline-flex h-12 w-12 items-center justify-center rounded-full text-ivory md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <svg id="hamburger-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.6" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="close-icon" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-width="1.6" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="nav-shell mx-auto mt-2 hidden max-w-[1240px] rounded-3xl p-3 md:hidden">
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`rounded-2xl px-4 py-3.5 font-serif text-2xl no-underline ${isActive ? "bg-ivory text-ink" : "text-ivory hover:bg-white/5"}`}
            aria-current={isActive ? "page" : undefined}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
    <div class="mt-3 grid gap-2 border-t border-white/10 pt-3">
      <a href="/free-nmc-check/" class="btn-primary w-full">Get a free NMC-aware check</a>
      <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-ghost w-full">
        WhatsApp us ({SITE_CONFIG.contact.whatsapp})
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", (!isExpanded).toString());
      toggleBtn.setAttribute("aria-label", isExpanded ? "Open menu" : "Close menu");
      mobileMenu.classList.toggle("hidden");
      hamburgerIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }
</script>
