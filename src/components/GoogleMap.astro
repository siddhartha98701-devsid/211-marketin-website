---
import { SITE_CONFIG } from "../config/site";

export interface Props {
  className?: string;
  compact?: boolean;
}

const { className = "", compact = false } = Astro.props;

const mapEmbedUrl = "https://www.google.com/maps?q=The+Capital+Science+City+Road+Sola+Ahmedabad+Gujarat+380060&output=embed";
const directionsUrl = "https://www.google.com/maps/search/?api=1&query=211+Marketing+B-1405+The+Capital+Science+City+Road+Sola+Ahmedabad+380060";
---

<div class={`glass min-w-0 max-w-full overflow-hidden rounded-3xl ${className}`}>
  <div class={`relative w-full ${compact ? "h-48" : "h-80 sm:h-[460px]"}`}>
    <iframe
      src={mapEmbedUrl}
      width="100%"
      height="100%" style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      sandbox="allow-scripts allow-same-origin allow-popups"
      title="211 Marketing office location: The Capital, Science City Road, Sola, Ahmedabad"
      class="h-full w-full"
    ></iframe>
  </div>
  <div class="flex min-w-0 items-center justify-between gap-3 border-t border-ink/10 px-4 py-3 text-xs">
    <span class="min-w-0 truncate text-body">{SITE_CONFIG.address.streetAddress}</span>
    <a href={directionsUrl} target="_blank" rel="noopener noreferrer" class="tap flex-none font-bold text-ink no-underline">
      Open in Maps →
    </a>
  </div>
</div>
