---
import { getActiveFaqs } from "../config/faq";
import { SITE_CONFIG } from "../config/site";

export interface Props {
  heading?: string;
  lead?: string;
}

const {
  heading = "Frequently asked questions",
  lead = "Short, direct answers in the format AI assistants quote."
} = Astro.props;

const faqs = getActiveFaqs(SITE_CONFIG.flags.showPricingFaq);
---

<section class="section rule-top" aria-labelledby="faq-section-heading">
  <div class="wrap flex flex-wrap gap-[clamp(32px,6vw,96px)]">
    <div class="flex flex-[1_1_280px] flex-col gap-4" data-reveal>
      <h2 id="faq-section-heading" class="h-section">{heading}</h2>
      {lead && <p class="body max-w-[320px]">{lead}</p>}
      <p class="body max-w-[320px]">
        Anything else? Call or WhatsApp <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="link-u font-bold text-accent-ink">{SITE_CONFIG.contact.whatsapp}</a>.
      </p>
    </div>
    <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-2" data-reveal-stagger>
      {faqs.map((faq, index) => (
        <details class="acc" id={`faq-${index + 1}`} open={index === 0}>
          <summary>
            <span class="acc-q font-serif text-[22px] leading-snug">{faq.question}</span>
            <span class="acc-icon" aria-hidden="true">+</span>
          </summary>
          <p class="acc-body">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
