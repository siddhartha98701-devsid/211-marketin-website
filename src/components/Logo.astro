---
/**
 * 211 Marketing logo: the rising "2 / 11" mark + "211 MARKETING" wordmark,
 * traced from the official logo and served as ivory SVGs for the dark site.
 */
export interface Props {
  size?: "sm" | "md";
}
const { size = "md" } = Astro.props;
const markH = size === "sm" ? 24 : 32;   // mark viewBox 536 × 430
const wordH = size === "sm" ? 9 : 11;    // wordmark viewBox 887 × 69
const markW = Math.round((536 / 430) * markH);
const wordW = Math.round((887 / 69) * wordH);
---

<span class="inline-flex items-center gap-2.5">
  <img
    src="/assets/211-logo-mark-ivory.svg"
    alt=""
    width={markW}
    height={markH}
    class="block flex-none"
    style={`height:${markH}px;width:auto`}
    decoding="async"
  />
  <img
    src="/assets/211-wordmark-ivory.svg"
    alt="211 Marketing"
    width={wordW}
    height={wordH}
    class="block flex-none"
    style={`height:${wordH}px;width:auto`}
    decoding="async"
  />
</span>
