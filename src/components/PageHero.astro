---
/**
 * Inner-page hero: an Ink Navy hero block (Brand Guidelines p. 11) with one
 * clear message. No decorative motifs or looping motion.
 */
export interface Props {
  eyebrow: string;
  lead?: string;
  id: string;
  align?: "center" | "left";
}
const { eyebrow, lead, id, align = "left" } = Astro.props;
const isCenter = align === "center";
---

<section class="theme-navy" aria-labelledby={id}>
  <div data-intro class={`wrap flex flex-col gap-6 pb-[clamp(56px,8vw,104px)] pt-[clamp(48px,7vw,96px)] ${isCenter ? "items-center text-center" : "items-start"}`}>
    <p class="eyebrow">{eyebrow}</p>
    <h1 id={id} class="display max-w-[860px]" data-split>
      <slot />
    </h1>
    {lead && <p class="lead max-w-[640px]">{lead}</p>}
    <slot name="after" />
  </div>
</section>
