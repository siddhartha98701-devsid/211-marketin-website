---
import { SITE_CONFIG } from "../config/site";

const showBanner = SITE_CONFIG.flags.analyticsEnabled;
---

{showBanner && (
  <div
    id="cookie-consent-banner"
    class="glass fixed bottom-24 left-4 right-4 z-50 hidden max-w-md rounded-3xl p-5 text-xs md:bottom-4 md:left-auto md:right-4"
    style="background: rgba(10,17,22,.92);"
    role="region"
    aria-label="Privacy and analytics preferences"
  >
    <div class="flex flex-col gap-2">
      <p class="lbl">Privacy &amp; analytics</p>
      <p class="leading-relaxed text-mist">
        We respect your privacy under the Indian DPDP Act 2023. We only use minimal, anonymised analytics to understand site performance. No advertising pixels or session recording.
      </p>
      <div class="flex items-center gap-2 pt-2">
        <button type="button" id="accept-analytics" class="btn-primary btn-sm">Accept</button>
        <button type="button" id="decline-analytics" class="btn-ghost btn-sm">Decline</button>
        <a href="/privacy/" class="link-u ml-auto text-amber-light">Policy</a>
      </div>
    </div>
  </div>

  <script>
    const banner = document.getElementById("cookie-consent-banner");
    const acceptBtn = document.getElementById("accept-analytics");
    const declineBtn = document.getElementById("decline-analytics");

    let consentStatus: string | null = null;
    try {
      consentStatus = localStorage.getItem("211_analytics_consent");
    } catch {
      consentStatus = null;
    }

    if (!consentStatus && banner) banner.classList.remove("hidden");

    const save = (value: string) => {
      try {
        localStorage.setItem("211_analytics_consent", value);
      } catch {
        /* storage unavailable */
      }
      banner?.classList.add("hidden");
    };

    acceptBtn?.addEventListener("click", () => save("granted"));
    declineBtn?.addEventListener("click", () => save("denied"));
  </script>
)}
