---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileFloatingBar from "../components/MobileFloatingBar.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  schemas?: Record<string, any>[];
  noindex?: boolean;
}

const { title, description, canonicalPath, ogImage, schemas, noindex } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      schemas={schemas}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-paper font-sans text-ink">
    <div class="grid-bg" aria-hidden="true"></div>

    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main-content" class="relative z-[1] flex-grow focus:outline-none">
      <slot />
    </main>

    <Footer />

    <MobileFloatingBar />

    <ConsentBanner />

    <script src="../scripts/motion.ts"></script>
  </body>
</html>
