---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import FreeCheckBand from "../components/FreeCheckBand.astro";
import { SITE_CONFIG } from "../config/site";
import { getBreadcrumbSchema } from "../schemas/jsonld";

const title = "About 211 Marketing | Doctor-Founded Healthcare Marketing";
const description = "211 Marketing is a doctor-founded healthcare communication firm in Ahmedabad, led by Dr Mrugesh, MD Anaesthesiology, FPCI.";

const breadcrumbSchema = getBreadcrumbSchema(SITE_CONFIG.placeholders.siteUrl, [
  { name: "About", path: "/about/" }
]);

const whatWeWontDoItems = [
  "guarantee patients",
  "post testimonials or before/afters",
  "buy reviews",
  "tie our fees to patient referrals"
];
---

<Layout title={title} description={description} canonicalPath="/about/" schemas={[breadcrumbSchema]}>
  <PageHero id="about-h1" eyebrow="About 211 · Doctor-founded">
    A marketing firm with a <em class="accent">doctor's eye.</em>
  </PageHero>

  <!-- Founder story -->
  <section class="section rule-top" aria-label="Founder story">
    <div class="wrap flex flex-wrap items-center gap-[clamp(40px,6vw,96px)]">
      <figure class="relative max-w-[420px] flex-[1_1_300px]" data-reveal data-tilt="3">
        <div class="relative aspect-[4/5] overflow-hidden border border-ink/25" style="border-radius: 220px 220px 28px 28px;">
          <img data-reveal-img src="/assets/about-clinical-founder.webp" alt="Physician founder reviewing clinical literature in a calm medical consultation office in Ahmedabad" width="800" height="1000" loading="lazy" decoding="async" class="h-full w-full object-cover" />
        </div>
        <figcaption class="relative mt-5 flex items-baseline justify-between gap-3">
          <span class="font-serif text-[26px]">{SITE_CONFIG.founder.name}</span>
          <span class="text-xs text-body">{SITE_CONFIG.founder.qualifications}</span>
        </figcaption>
      </figure>

      <div class="flex min-w-0 flex-[999_1_480px] flex-col gap-8" data-reveal>
        <p class="lbl">The story</p>
        <p class="font-serif text-[clamp(24px,2.6vw,34px)] leading-[1.4] text-ink">
          211 Marketing was founded by Dr Mrugesh, MD Anaesthesiology, FPCI, who has been active professionally in Ahmedabad for nine years. Having worked inside healthcare, he saw the same problem again and again: good clinics marketed like shops, or not at all. 211 exists to fix that, with communication that is accurate, useful and quietly premium.
        </p>
      </div>
    </div>
  </section>

  <!-- The name -->
  <section class="pb-[clamp(80px,11vw,150px)]" aria-labelledby="name-heading">
    <div class="wrap">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="lbl mb-4">The name</p>
          <h2 id="name-heading" class="h-section">Creativity + Structure = <em class="accent">Growth.</em></h2>
        </div>
        <p class="body max-w-[420px]">2 is the sweep of creative thinking; 11 is the structure of disciplined execution. Together: Creativity + Structure = Growth.</p>
      </div>
      <div class="swipe-row grid gap-3 sm:grid-cols-3" data-reveal-stagger>
        <div class="card glass flex min-h-[220px] flex-col justify-end rounded-2xl p-8" data-tilt="3">
          <div><p class="num text-[64px]">2</p><p class="body mt-3">The sweep of creative thinking</p></div>
        </div>
        <div class="card glass flex min-h-[220px] flex-col justify-end rounded-2xl p-8" data-tilt="3">
          <div><p class="num text-[64px]">11</p><p class="body mt-3">The structure of disciplined execution</p></div>
        </div>
        <div class="theme-navy flex min-h-[220px] flex-col justify-between rounded-2xl p-8" data-tilt="3">
          <span class="text-[12px] font-bold tracking-[0.08em]">TOGETHER</span>
          <div><p class="num text-[64px]">=</p><p class="mt-3 text-[15px] font-bold">Creativity + Structure = Growth</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Believe / Won't do -->
  <section class="section rule-top" aria-label="What we believe and what we won't do">
    <div class="wrap"><div class="swipe-row swipe-lg grid gap-3 lg:grid-cols-2">
      <div class="glass flex flex-col gap-6 rounded-3xl p-[clamp(28px,4vw,48px)]" data-reveal data-tilt="2">
        <p class="lbl">What we believe</p>
        <h2 class="sr-only">What we believe</h2>
        <ul class="flex flex-col gap-1">
          {["Healthcare is not ordinary advertising.", "Visibility should never cost credibility.", "Less noise, more intent."].map((b) => (
            <li class="border-t border-ink/10 py-4 font-serif text-[clamp(22px,2.2vw,30px)] italic leading-snug">{b}</li>
          ))}
        </ul>
      </div>
      <div class="alert flex flex-col gap-6 rounded-3xl p-[clamp(28px,4vw,48px)]" data-reveal data-tilt="2">
        <p class="inline-flex items-center gap-2.5 text-xs font-bold tracking-[0.08em] text-accent-ink">WHAT WE WON'T DO</p>
        <h2 class="sr-only">What we won't do</h2>
        <ul class="flex flex-col">
          {whatWeWontDoItems.map((item) => (
            <li class="flex items-center gap-4 border-t border-accent/20 py-4 text-[17px] text-body">
              <span class="inline-flex h-7 w-7 flex-none items-center justify-center rounded-full border border-accent/50 text-accent-ink" aria-hidden="true">×</span>
              <span class="first-letter:uppercase">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div></div>
  </section>

  <FreeCheckBand />
</Layout>
