---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import FreeCheckBand from "../components/FreeCheckBand.astro";
import { SITE_CONFIG } from "../config/site";
import { SERVICES_DATA, SERVICES_CLOSING_LINE } from "../config/services";
import { getServicesSchema, getBreadcrumbSchema } from "../schemas/jsonld";

const title = "Healthcare Social Media, Google & Websites | 211 Marketing";
const description = "Healthcare social media, Google Business Profile, local SEO, websites and communication audits for Ahmedabad clinics and hospitals.";

const servicesSchema = getServicesSchema(SITE_CONFIG.placeholders.siteUrl, SERVICES_DATA);
const breadcrumbSchema = getBreadcrumbSchema(SITE_CONFIG.placeholders.siteUrl, [
  { name: "Services", path: "/services/" }
]);

const serviceMeta: Record<string, { src: string; alt: string; tags: string[] }> = {
  "healthcare-social-media": { src: "/assets/service-social-media.webp", alt: "Medical educational social media carousel displayed on a physician tablet", tags: ["Monthly plans", "Reels", "Carousels", "NMC review"] },
  "google-business-profile-local-seo": { src: "/assets/service-local-seo.webp", alt: "Modern clinic entrance with accurate signage and ambient lighting in Ahmedabad", tags: ["Listings", "Services", "Photos", "Q&A"] },
  "healthcare-websites": { src: "/assets/service-websites.webp", alt: "Fast, responsive healthcare website interface on a modern doctor workspace", tags: ["Mobile-first", "Doctor directory", "Answer-first FAQs"] },
  "brand-content": { src: "/assets/service-brand-content.webp", alt: "Restrained medical brand identity, typography, and stationery collateral", tags: ["Positioning", "Visual identity", "Medical copywriting"] },
  "nmc-aware-communication-audit": { src: "/assets/service-audit.webp", alt: "Structured NMC compliance audit checklist on physician consultation desk", tags: ["Website", "Social media", "Campaigns", "Fix list"] },
  "institutional-media": { src: "/assets/service-institutional-media.webp", alt: "Modern multi-speciality hospital campus building with glass and limestone architecture", tags: ["Eligible institutions", "Paid campaigns", "Within NMC guidance"] }
};
const total = String(SERVICES_DATA.length).padStart(2, "0");
---

<Layout title={title} description={description} canonicalPath="/services/" schemas={[servicesSchema, breadcrumbSchema]}>
  <PageHero id="services-h1" eyebrow="What we do · Six services">
    Healthcare marketing services.
    <nav slot="after" class="swipe-row swipe-chips flex max-w-[860px] flex-wrap justify-center gap-1.5 pt-2" aria-label="Jump to a service">
      {SERVICES_DATA.map((s) => <a href={`#${s.id}`} class="chip no-underline">{s.title}</a>)}
    </nav>
  </PageHero>

  <section class="pb-[clamp(80px,11vw,150px)]" aria-label="Service list">
    <div class="wrap flex flex-col gap-4">
      <div class="swipe-row swipe-lg flex flex-col gap-4" data-stack>
      {SERVICES_DATA.map((service, index) => {
        const m = serviceMeta[service.id];
        const n = String(index + 1).padStart(2, "0");
        const flip = index % 2 === 1;
        return (
          <article id={service.id} class="card glass grid overflow-hidden rounded-[32px] lg:grid-cols-12" data-reveal>
            <div class={`relative flex flex-col justify-between gap-10 p-[clamp(28px,4vw,56px)] lg:col-span-7 ${flip ? "lg:order-2" : ""}`}>
              <div class="relative flex items-start justify-between gap-6">
                <span class="idx">Service {n} / {total}</span>
                <span class="num text-[clamp(72px,9vw,128px)] text-accent" aria-hidden="true">{n}</span>
              </div>
              <div class="relative flex flex-col gap-5">
                <h2 class="font-serif text-[clamp(32px,3.6vw,48px)] leading-[1.02]">{service.title}</h2>
                <p class="lead max-w-[560px]">{service.copy}</p>
                {m && (
                  <div class="flex flex-wrap gap-2 pt-1">
                    {m.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                )}
              </div>
            </div>
            {m && (
              <div class={`relative min-h-[260px] overflow-hidden lg:col-span-5 ${flip ? "lg:order-1" : ""}`}>
                <img data-reveal-img src={m.src} alt={m.alt} width="960" height="540" loading="lazy" decoding="async" class="card-img absolute inset-0 h-full w-full object-cover" />
                <div class="absolute inset-0" style={`background: linear-gradient(${flip ? "270deg" : "90deg"}, rgba(14,23,30,.9), transparent 60%);`} aria-hidden="true"></div>
              </div>
            )}
          </article>
        );
      })}
      </div>

      <p class="pt-10 text-center font-serif text-[clamp(24px,2.6vw,34px)] italic text-body" data-reveal>{SERVICES_CLOSING_LINE}</p>
    </div>
  </section>

  <FreeCheckBand />
</Layout>
