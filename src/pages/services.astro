---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "../config/site";
import { SERVICES_DATA, SERVICES_CLOSING_LINE } from "../config/services";
import { getServicesSchema, getBreadcrumbSchema } from "../schemas/jsonld";

const title = "Healthcare Social Media, Google & Websites | 211 Marketing";
const description = "Healthcare social media, Google Business Profile, local SEO, websites and communication audits for Ahmedabad clinics and hospitals.";

const servicesSchema = getServicesSchema(SITE_CONFIG.placeholders.siteUrl, SERVICES_DATA);
const breadcrumbSchema = getBreadcrumbSchema(SITE_CONFIG.placeholders.siteUrl, [
  { name: "Services", path: "/services/" }
]);

const serviceImages: Record<string, { src: string; alt: string }> = {
  "healthcare-social-media": {
    src: "/assets/service-social-media.webp",
    alt: "Medical educational social media carousel displayed on a physician tablet"
  },
  "google-business-profile-local-seo": {
    src: "/assets/service-local-seo.webp",
    alt: "Modern clinic entrance with accurate signage and ambient lighting in Ahmedabad"
  },
  "healthcare-websites": {
    src: "/assets/service-websites.webp",
    alt: "Fast, responsive healthcare website interface on a modern doctor workspace"
  },
  "brand-content": {
    src: "/assets/service-brand-content.webp",
    alt: "Restrained medical brand identity, typography, and stationery collateral"
  },
  "nmc-aware-communication-audit": {
    src: "/assets/service-audit.webp",
    alt: "Structured NMC compliance audit checklist on physician consultation desk"
  },
  "institutional-media": {
    src: "/assets/service-institutional-media.webp",
    alt: "Modern multi-speciality hospital campus building with glass and limestone architecture"
  }
};
---

<Layout
  title={title}
  description={description}
  canonicalPath="/services/"
  schemas={[servicesSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class="bg-navy text-canvas-warm pt-16 pb-20 sm:pt-24 sm:pb-28 border-b border-navy-light" aria-labelledby="services-h1">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <h1 id="services-h1" class="text-4xl sm:text-5xl lg:text-6xl font-serif font-semibold tracking-tight text-canvas-warm leading-[1.15] max-w-4xl mx-auto">
        Healthcare marketing services.
      </h1>

    </div>
  </section>

  <!-- Service List Section (Each service gets an H2 and one short paragraph verbatim) -->
  <section class="py-16 sm:py-24 bg-canvas" aria-labelledby="services-list-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="services-list-heading" class="sr-only">List of Services</h2>
      
      <div class="divide-y divide-stone-soft" data-reveal-stagger>
        {SERVICES_DATA.map((service, index) => {
          const img = serviceImages[service.id];
          const isEven = index % 2 === 1;
          return (
            <article id={service.id} class="py-12 sm:py-16 first:pt-0 last:pb-8 group transition-colors">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
                <div class={`space-y-4 md:col-span-7 ${isEven ? 'md:order-2' : ''}`}>
                  <h2 class="text-3xl sm:text-4xl font-serif font-semibold text-navy">
                    {service.title}
                  </h2>
                  <p class="text-lg sm:text-xl text-navy/85 font-sans leading-relaxed pt-1">
                    {service.copy}
                  </p>
                </div>
                {img && (
                  <div class={`md:col-span-5 overflow-hidden rounded-xl border border-stone-soft bg-canvas-muted shadow-2xs aspect-16/10 ${isEven ? 'md:order-1' : ''}`}>
                    <img
                      src={img.src}
                      alt={img.alt}
                      width="960"
                      height="540"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                    />
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>

      <!-- Closing line -->
      <div class="mt-16 pt-10 border-t-2 border-stone-soft text-center sm:text-left" data-reveal>
        <p class="text-2xl sm:text-3xl font-serif italic text-navy">
          {SERVICES_CLOSING_LINE}
        </p>
      </div>

    </div>
  </section>
</Layout>
