---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import FreeCheckBand from "../components/FreeCheckBand.astro";
import { SITE_CONFIG } from "../config/site";
import { getActiveFaqs } from "../config/faq";
import { getFAQPageSchema, getBreadcrumbSchema } from "../schemas/jsonld";

const title = "Hospital & Clinic Marketing in Ahmedabad | 211 Marketing";
const description = "Ethical, premium marketing for hospitals, clinics, diagnostics and specialists, built around the NMC guidelines of 6 October 2026.";

const activeFaqs = getActiveFaqs(SITE_CONFIG.flags.showPricingFaq);
const faqSchema = getFAQPageSchema(activeFaqs);
const breadcrumbSchema = getBreadcrumbSchema(SITE_CONFIG.placeholders.siteUrl, [
  { name: "Healthcare Marketing", path: "/healthcare-marketing/" }
]);

const whoWeWorkWith = [
  { title: "Hospitals and multi-speciality centres", image: "/assets/sector-hospitals.webp", alt: "Architectural exterior of a modern multi-speciality hospital in Ahmedabad" },
  { title: "Clinics and day-care centres", image: "/assets/sector-clinics.webp", alt: "Serene boutique clinic reception and consultation space" },
  { title: "Diagnostics and labs", image: "/assets/sector-diagnostics.webp", alt: "Modern high-precision diagnostic imaging and laboratory suite" },
  { title: "Individual specialists", image: "/assets/sector-specialists.webp", alt: "Physician consultation desk with stethoscope and journal" }
];

const whatChangesForYou = [
  "a Google profile that answers patients' questions",
  "a feed that looks like the quality of your care",
  "no testimonials, before/afters or \"best doctor\" claims that put you at risk",
  "one partner for strategy, content, search and web"
];
---

<Layout title={title} description={description} canonicalPath="/healthcare-marketing/" schemas={[faqSchema, breadcrumbSchema]}>
  <PageHero
    id="healthcare-h1"
    eyebrow="Hospitals · Clinics · Diagnostics · Specialists"
    lead="Patients choose healthcare on trust. We build that trust with clear information, calm design and content that respects the NMC guidelines."
  >
    Hospital and clinic marketing in Ahmedabad, <em class="accent">done properly.</em>
    <div slot="after" class="pt-2">
      <a href="/free-nmc-check/" class="btn-primary">Start with a free check <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </PageHero>

  <!-- Who we work with -->
  <section class="section rule-top" aria-labelledby="who-heading">
    <div class="wrap">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="lbl mb-4">Who we work with</p>
          <h2 id="who-heading" class="h-section">Four kinds of care. <em class="accent">One standard.</em></h2>
        </div>
      </div>
      <div class="swipe-row grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {whoWeWorkWith.map((item, i) => (
          <article class="card glass flex flex-col rounded-3xl">
            <div class="relative aspect-[4/5] overflow-hidden rounded-t-3xl">
              <img data-reveal-img src={item.image} alt={item.alt} width="800" height="1000" loading="lazy" decoding="async" class="card-img h-full w-full object-cover" />
            </div>
            <h3 class="p-6 font-serif text-[24px] leading-tight">{item.title}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- What changes for you -->
  <section class="pb-[clamp(80px,11vw,150px)]" aria-labelledby="changes-heading">
    <div class="wrap">
      <div class="glass grid items-stretch gap-0 overflow-hidden rounded-[32px] lg:grid-cols-12" data-reveal>
        <div class="flex flex-col gap-8 p-[clamp(28px,5vw,64px)] lg:col-span-7">
          <p class="lbl">What changes for you</p>
          <h2 id="changes-heading" class="h-section">Clearer. Calmer. <em class="accent">Safer.</em></h2>
          <ul class="flex flex-col">
            {whatChangesForYou.map((item) => (
              <li class="flex items-start gap-4 border-t border-ink/10 py-5 text-[17px] leading-snug text-body">
                <span class="mt-0.5 inline-flex h-6 w-6 flex-none items-center justify-center rounded-full border border-ink/50 text-xs text-ink" aria-hidden="true">✓</span>
                <span class="first-letter:uppercase">{item}</span>
              </li>
            ))}
          </ul>
          <a href="/free-nmc-check/" class="btn-primary self-start">Start with a free check <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="relative min-h-[320px] lg:col-span-5">
          <img data-reveal-img src="/assets/service-websites.webp" alt="Clear, responsive digital healthcare presence complying with clinical standards" width="960" height="540" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <FreeCheckBand />

  <FAQAccordion heading="Frequently asked questions" lead="Short, direct answers in the format AI assistants quote." />
</Layout>
