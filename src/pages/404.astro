---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

const title = "Page not found | 211 Marketing";
const description = "This page could not be found. Go back to the 211 Marketing home page or request a free NMC-aware check.";

const links = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services" },
  { href: "/nmc-guidelines-2026/", label: "NMC guidelines 2026, explained" },
  { href: "/contact/", label: "Contact" }
];
---

<Layout title={title} description={description} canonicalPath="/404/" noindex>
  <PageHero id="notfound-h1" eyebrow="Error 404" lead="The page you were looking for has moved or no longer exists.">
    Page not found.
    <div slot="after" class="flex flex-wrap gap-3 pt-2">
      <a href="/" class="btn-primary">Back to home <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/free-nmc-check/" class="btn-ghost">Get a free NMC-aware check</a>
    </div>
  </PageHero>

  <section class="section-tight">
    <div class="wrap">
      <p class="lbl mb-4">Popular pages</p>
      <ul class="flex flex-col">
        {links.map((l) => (
          <li class="border-t border-ink/10 last:border-b">
            <a href={l.href} class="group flex items-center justify-between gap-6 py-5 font-serif text-[clamp(22px,2vw,28px)] text-ink no-underline">
              {l.label}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
