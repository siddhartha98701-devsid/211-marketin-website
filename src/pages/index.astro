---
import Layout from "../layouts/Layout.astro";
import FreeCheckBand from "../components/FreeCheckBand.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import { SITE_CONFIG } from "../config/site";
import { SERVICES_DATA } from "../config/services";
import { getActiveFaqs } from "../config/faq";
import { getFAQPageSchema } from "../schemas/jsonld";

const title = "Healthcare Marketing Agency in Ahmedabad | 211 Marketing";
const description = "Doctor-founded, NMC-aware marketing for hospitals, clinics and diagnostic centres in Ahmedabad. Social media, Google, websites. Get a free check.";

const activeFaqs = getActiveFaqs(SITE_CONFIG.flags.showPricingFaq);
const faqSchema = getFAQPageSchema(activeFaqs);

// "What we do" (brief): the five home-page services, linking to Services
const whatWeDo = SERVICES_DATA.filter((s) => s.id !== "institutional-media");

const whoWeServe = [
  "Hospitals & multi-speciality centres",
  "Clinics & day-care centres",
  "Diagnostics & labs",
  "Individual specialists",
  "Ahmedabad & Gujarat"
];

const facts = [
  { label: "Review", n: "8", unit: "pts", line: "on every post, page and profile" },
  { label: "Free check", n: "15", unit: "pts", line: "across Instagram, Google and website" },
  { label: "Turnaround", n: "48", unit: "h", line: "to your one-page review" },
  { label: "Founder", n: "9", unit: "yrs", line: "active professionally in Ahmedabad" }
];

const steps = [
  { name: "Classify.", copy: "Doctor, clinic, hospital or diagnostics: the rules differ, so we start there." },
  { name: "Check.", copy: "Credentials, claims and current content, reviewed against the NMC guidelines." },
  { name: "Create.", copy: "Calm, premium content and pages your patients find useful." },
  { name: "Care.", copy: "Monthly review, honest reporting, steady improvement." }
];
---

<Layout title={title} description={description} canonicalPath="/" schemas={[faqSchema]}>
  <!-- HERO: Ink Navy hero block, one message, one visual focus -->
  <section class="theme-navy" aria-labelledby="home-h1">
    <div class="wrap grid items-center gap-[clamp(32px,5vw,72px)] pb-[clamp(56px,8vw,112px)] pt-[clamp(40px,6vw,88px)] lg:grid-cols-12" data-hero-3d>
      <div class="flex flex-col gap-7 lg:col-span-6">
        <p class="lbl">Doctor-founded · NMC-aware · Ahmedabad</p>
        <h1 id="home-h1" class="display">
          Healthcare marketing, held to a <em class="accent">clinical standard.</em>
        </h1>
        <p class="lead max-w-[520px]">
          We help hospitals, clinics and diagnostic centres in Ahmedabad become clearer, more credible and easier to find, without putting a registration at risk.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/free-nmc-check/" class="btn-primary">Get a free NMC-aware check <span class="arrow" aria-hidden="true">→</span></a>
          <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-ghost">WhatsApp us</a>
        </div>
        <a href="/nmc-guidelines-2026/" class="link-u mt-2 self-start py-2 text-[14px] text-body">
          New NMC advertising guidelines took effect on 6 October 2026. See what changed →
        </a>
      </div>
      <figure class="overflow-hidden rounded-2xl lg:col-span-6" data-parallax>
        <img
          src="/assets/hero-clinical-editorial.webp"
          alt="Calm, naturally lit consultation room with a wooden desk, stethoscope and navy chairs beside a garden window"
          width="1376"
          height="768"
          fetchpriority="high"
          decoding="async"
          class="aspect-[4/3] w-full object-cover lg:aspect-[5/6]"
        />
      </figure>
    </div>
  </section>

  <!-- Who we work with -->
  <section aria-label="Who we work with" class="border-b border-ink/10">
    <ul class="wrap flex flex-wrap items-center justify-center gap-x-8 gap-y-3 py-7 font-serif text-[clamp(18px,1.6vw,22px)] italic text-body">
      {whoWeServe.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <!-- INTRO (answer-first, quotable) + FACTS -->
  <section class="section" aria-label="Who we are">
    <div class="wrap">
      <p class="lbl mb-6" data-reveal>In one paragraph</p>
      <p class="max-w-[980px] font-serif text-[clamp(24px,2.6vw,34px)] leading-[1.3] text-body" data-reveal>
        211 Marketing is a <span class="text-ink">doctor-founded healthcare marketing agency in Ahmedabad.</span> We plan and run <span class="text-ink">social media, Google Business Profile, local SEO and websites</span> for hospitals, clinics, diagnostic centres and specialists, and every piece passes an <em class="accent">8-point review</em> built around the NMC guidelines dated 6 October 2026.
      </p>
      <div class="swipe-row swipe-sm mt-[clamp(48px,6vw,80px)] grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {facts.map((f) => (
          <div class="glass flex flex-col gap-4 rounded-2xl p-6" data-tilt="3">
            <span class="lbl">{f.label}</span>
            <span class="num text-[64px]"><span data-count={f.n}>{f.n}</span><span class="text-xl text-meta"> {f.unit}</span></span>
            <span class="text-[14px] text-body">{f.line}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THREE REASONS -->
  <section class="pb-[clamp(72px,9vw,128px)]" aria-labelledby="reasons-heading">
    <div class="wrap">
      <h2 id="reasons-heading" class="sr-only">Why 211 Marketing</h2>
      <div class="swipe-row swipe-lg grid gap-3 md:grid-cols-3" data-reveal-stagger>
        {[
          { lbl: "01 · Medicine", h: "We speak fluent medicine.", p: "Our founder is a doctor, so we know the difference between a procedure and a promise." },
          { lbl: "02 · Instagram", h: "And fluent Instagram.", p: "Reels, carousels and Google profiles that people actually stop for, and save." },
          { lbl: "03 · Rules", h: "Rules first, reach second.", p: "Every post is checked for credentials, claims, patient privacy and AI use before it goes live." }
        ].map((r) => (
          <article class="card glass flex min-h-[260px] flex-col justify-end gap-3.5 rounded-2xl p-8" data-tilt="3">
            <span class="lbl">{r.lbl}</span>
            <h3 class="h-card">{r.h}</h3>
            <p class="body">{r.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section rule-top" aria-labelledby="what-we-do-heading">
    <div class="wrap flex flex-wrap gap-12">
      <div class="flex flex-[1_1_300px] flex-col gap-5" data-reveal>
        <p class="lbl">What we do</p>
        <h2 id="what-we-do-heading" class="h-section">Inspect every <em class="accent">touchpoint.</em></h2>
        <a href="/services/" class="btn-ghost btn-sm mt-2 self-start">All services <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ol class="flex min-w-0 flex-[999_1_560px] flex-col" data-reveal-stagger>
        {whatWeDo.map((s, i) => (
          <li class="border-t border-ink/10 last:border-b">
            <a href={`/services/#${s.id}`} class="group flex items-center gap-6 py-6 no-underline">
              <span class="num w-10 text-[24px] text-accent">0{i + 1}</span>
              <span class="flex-1 font-serif text-[clamp(22px,2vw,28px)] leading-tight text-ink group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">{s.title}</span>
              <span class="arrow text-ink transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="pb-[clamp(72px,9vw,128px)]" aria-labelledby="how-heading">
    <div class="wrap">
      <div class="mb-12" data-reveal>
        <p class="lbl mb-4">How we work</p>
        <h2 id="how-heading" class="h-section">Four calm steps.</h2>
      </div>
      <ol class="swipe-row grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {steps.map((s, i) => (
          <li class="flex flex-col gap-3 border-t border-ink pt-6" data-rule>
            <span class="lbl">Step 0{i + 1}</span>
            <h3 class="font-serif text-[28px]">{s.name}</h3>
            <p class="body">{s.copy}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FreeCheckBand />

  <FAQAccordion heading="Straight answers." lead="Short, direct answers in the format AI assistants quote." />

  <!-- CLOSING LINE -->
  <section aria-label="Closing" class="rule-top">
    <div class="wrap flex flex-col items-center gap-10 py-[clamp(96px,12vw,168px)] text-center" data-reveal>
      <p class="font-serif text-[clamp(44px,6vw,80px)] leading-[1.1]">Less noise.<br /><em class="accent">More trust.</em></p>
      <a href="/free-nmc-check/" class="btn-primary">Get my free check <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>
