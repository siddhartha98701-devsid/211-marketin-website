---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import GoogleMap from "../components/GoogleMap.astro";
import { SITE_CONFIG } from "../config/site";
import { getBreadcrumbSchema } from "../schemas/jsonld";

const title = "Contact 211 Marketing | Science City Road, Sola, Ahmedabad";
const description = "Visit or call 211 Marketing at B-1405, The Capital, Science City Road, Sola, Ahmedabad 380060. Call or WhatsApp +91 90990 97585.";

const breadcrumbSchema = getBreadcrumbSchema(SITE_CONFIG.placeholders.siteUrl, [
  { name: "Contact", path: "/contact/" }
]);

const rows = [
  { k: "Call / WhatsApp", v: SITE_CONFIG.contact.whatsapp, href: SITE_CONFIG.contact.whatsappHref, ext: true },
  { k: "Instagram", v: SITE_CONFIG.contact.instagram, href: SITE_CONFIG.contact.instagramHref, ext: true },
  { k: "Email", v: SITE_CONFIG.placeholders.businessEmail, href: `mailto:${SITE_CONFIG.placeholders.businessEmail}`, ext: false },
  { k: "Hours", v: SITE_CONFIG.placeholders.hours, href: "", ext: false }
];
---

<Layout title={title} description={description} canonicalPath="/contact/" schemas={[breadcrumbSchema]}>
  <PageHero id="contact-h1" eyebrow="Science City Road · Sola · Ahmedabad" lead="Tea is on us. So is your first check.">
    Let's talk <em class="accent">healthcare.</em>
    <div slot="after" class="flex flex-wrap justify-center gap-3 pt-2">
      <a href={SITE_CONFIG.contact.phoneHref} class="btn-primary">Call {SITE_CONFIG.contact.whatsapp}</a>
      <a href={SITE_CONFIG.contact.whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-ghost">WhatsApp us</a>
    </div>
  </PageHero>

  <section class="pb-[clamp(80px,11vw,150px)]">
    <div class="wrap grid items-start gap-6 lg:grid-cols-12">
      <div class="flex min-w-0 flex-col gap-4 lg:col-span-5">
        <div class="glass rounded-3xl p-6 sm:p-8" data-reveal>
          <div class="flex flex-col gap-2 border-b border-ink/10 pb-6">
            <span class="lbl">Visit</span>
            <h2 class="font-serif text-[30px]">{SITE_CONFIG.name}</h2>
            <address class="text-base not-italic leading-relaxed text-body">
              {SITE_CONFIG.address.streetAddress},<br />
              {SITE_CONFIG.address.addressLocality}, {SITE_CONFIG.address.addressRegion} {SITE_CONFIG.address.postalCode}
            </address>
          </div>
          <dl class="flex flex-col">
            {rows.map((r) => (
              <div class="flex flex-col gap-1.5 border-b border-ink/10 py-4 last:border-0">
                <dt class="meta">{r.k}</dt>
                <dd>
                  {r.href ? (
                    <a href={r.href} {...(r.ext ? { target: "_blank", rel: "noopener noreferrer" } : {})} class="link-u tap text-lg text-ink">{r.v}</a>
                  ) : (
                    <span class="text-lg text-ink">{r.v}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="card glass overflow-hidden rounded-3xl" data-reveal data-tilt="3">
          <div class="relative aspect-video overflow-hidden">
            <img data-reveal-img src="/assets/contact-ahmedabad-office.webp" alt="Architectural exterior of The Capital on Science City Road, Sola, Ahmedabad" width="960" height="540" loading="lazy" decoding="async" class="card-img h-full w-full object-cover" />
          </div>
          <p class="px-5 py-4 text-center text-xs text-body">The Capital · Science City Road, Sola, Ahmedabad</p>
        </div>
      </div>

      <div class="min-w-0 lg:col-span-7" data-reveal data-depth>
        <GoogleMap />
      </div>
    </div>
  </section>
</Layout>
