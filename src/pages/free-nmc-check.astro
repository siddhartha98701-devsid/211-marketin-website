---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { SITE_CONFIG } from "../config/site";
import { getBreadcrumbSchema } from "../schemas/jsonld";

const title = "Free NMC-Aware Check for Clinics & Hospitals | 211 Marketing";
const description = "A free 15-point review of your clinic's Instagram, Google profile and website against the new NMC rules. One page, within 48 hours.";

const breadcrumbSchema = getBreadcrumbSchema(SITE_CONFIG.placeholders.siteUrl, [
  { name: "Free NMC Check", path: "/free-nmc-check/" }
]);

const turnstileSiteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || "";

const whatWeCheckItems = [
  "credentials and registration details",
  "claims and superlatives",
  "testimonials and patient images",
  "offers and urgency",
  "AI-made content",
  "Google profile accuracy",
  "website basics"
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/free-nmc-check/"
  schemas={[breadcrumbSchema]}
>
  <PageHero
    id="free-check-h1"
    eyebrow="Free · 15 points · 48 hours"
    lead="Send us your Instagram, Google profile and website. Within 48 hours you'll get a one-page review: what's clear, what to review and what to fix."
  >
    Your free NMC-aware check.
  </PageHero>

  <section class="relative pb-[clamp(80px,11vw,150px)]">
    <div class="wrap">
      <div class="grid items-start gap-6 lg:grid-cols-12">

        <!-- Left: what we check -->
        <div class="flex flex-col gap-4 lg:col-span-5">
          <div class="glass rounded-3xl p-8" data-reveal data-depth>
            <div class="mb-5 flex items-center justify-between gap-3">
              <h2 class="font-serif text-[30px]">What we check</h2>
            </div>
            <ul class="flex flex-col">
              {whatWeCheckItems.map((item, i) => (
                <li class="flex items-center gap-4 border-t border-ink/10 py-3.5 text-[15px] text-body">
                  <span class="num w-7 text-lg text-meta">{String(i + 1).padStart(2, "0")}</span>
                  <span class="first-letter:uppercase">{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="glass flex items-center gap-4 rounded-3xl p-6" data-reveal>
            <span class="num text-[56px]">48<span class="text-lg tracking-normal text-accent">h</span></span>
            <p class="body">One page. What's clear, what to review and what to fix. Then a short call, only if you'd like one.</p>
          </div>
        </div>

        <!-- Right: form -->
        <div class="lg:col-span-7">
          <div class="glass relative overflow-hidden rounded-2xl p-[clamp(24px,4vw,44px)]" data-reveal data-depth>

            <!-- Success -->
            <div id="form-success-box" class="relative flex hidden min-h-[340px] flex-col justify-center gap-4" role="status">
              <span class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-ink text-paper">
                <svg width="22" height="22" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 9.2l3.2 3.2 6.6-6.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </span>
              <p class="font-serif text-[38px]">Request received.</p>
              <p class="lead">Thank you. We'll send your one-page check on WhatsApp or email within 48 hours.</p>
            </div>

            <!-- Error -->
            <div id="form-error-box" class="relative mb-6 hidden rounded-2xl border border-[#F2A7A0]/40 bg-[#F2A7A0]/10 p-4 text-sm text-[#F8CFCA]" role="alert">
              <p id="form-error-msg">Please review the highlighted fields below.</p>
            </div>

            <form id="free-check-form" action="/api/free-nmc-check" method="POST" class="relative grid grid-cols-1 gap-x-6 gap-y-5 sm:grid-cols-2" novalidate>
              <div class="mb-1 flex items-center justify-between gap-3 sm:col-span-2">
                <h2 class="font-serif text-[30px]">Request your check</h2>
                <span class="text-xs text-meta"><span aria-hidden="true">*</span> required</span>
              </div>

              <!-- Honeypot -->
              <div class="pointer-events-none absolute -z-50 h-0 w-0 select-none overflow-hidden opacity-0" aria-hidden="true">
                <label for="website_url_hp">Leave this empty</label>
                <input type="text" id="website_url_hp" name="website_url_hp" tabindex="-1" autocomplete="off" />
              </div>
              <input type="hidden" id="form_rendered_at" name="form_rendered_at" value="" />

              <label for="name" class="field-label">
                <span>Name <span aria-hidden="true">*</span></span>
                <input type="text" id="name" aria-describedby="error-name" name="name" required maxlength="100" autocomplete="name" class="field" placeholder="Dr. Full Name" />
                <span id="error-name" class="field-error hidden" aria-live="polite"></span>
              </label>

              <label for="organisation" class="field-label">
                <span>Organisation <span aria-hidden="true">*</span></span>
                <input type="text" id="organisation" aria-describedby="error-organisation" name="organisation" required maxlength="120" autocomplete="organization" class="field" placeholder="Clinic, hospital or practice" />
                <span id="error-organisation" class="field-error hidden" aria-live="polite"></span>
              </label>

              <label for="entityType" class="field-label">
                <span>I am a <span aria-hidden="true">*</span></span>
                <select id="entityType" aria-describedby="error-entityType" name="entityType" required class="field">
                  <option value="" disabled selected>Select practice type…</option>
                  <option value="Doctor">Doctor</option>
                  <option value="Clinic">Clinic</option>
                  <option value="Hospital">Hospital</option>
                  <option value="Diagnostics">Diagnostics</option>
                  <option value="Other">Other</option>
                </select>
                <span id="error-entityType" class="field-error hidden" aria-live="polite"></span>
              </label>

              <label for="city" class="field-label">
                <span>City <span aria-hidden="true">*</span></span>
                <input type="text" id="city" aria-describedby="error-city" name="city" required maxlength="80" autocomplete="address-level2" class="field" placeholder="e.g. Ahmedabad" />
                <span id="error-city" class="field-error hidden" aria-live="polite"></span>
              </label>

              <label for="instagram" class="field-label">
                <span>Instagram handle <span aria-hidden="true">*</span></span>
                <span class="relative block">
                  <span class="absolute inset-y-0 left-0 flex items-center text-base font-normal tracking-normal text-meta" aria-hidden="true">@</span>
                  <input type="text" id="instagram" aria-describedby="error-instagram" name="instagram" required maxlength="35" class="field pl-5" placeholder="clinic_handle" />
                </span>
                <span id="error-instagram" class="field-error hidden" aria-live="polite"></span>
              </label>

              <label for="website" class="field-label">
                <span>Website <span class="font-normal normal-case tracking-normal text-meta">(optional)</span></span>
                <input type="url" id="website" aria-describedby="error-website" name="website" maxlength="200" autocomplete="url" class="field" placeholder="https://example.com" />
                <span id="error-website" class="field-error hidden" aria-live="polite"></span>
              </label>

              <label for="whatsapp" class="field-label sm:col-span-2">
                <span>WhatsApp number <span aria-hidden="true">*</span></span>
                <input type="tel" id="whatsapp" aria-describedby="error-whatsapp" name="whatsapp" required maxlength="16" autocomplete="tel" class="field" placeholder="10-digit mobile (e.g. 90990 97585)" />
                <span id="error-whatsapp" class="field-error hidden" aria-live="polite"></span>
              </label>

              <div class="sm:col-span-2">
                <div class="flex min-h-[44px] items-start gap-3">
                  <input type="checkbox" id="consent" aria-describedby="error-consent" name="consent" required class="mt-0.5 h-[22px] w-[22px] flex-none" style="accent-color: #263947;" />
                  <label for="consent" class="text-sm leading-normal text-body">
                    I agree to be contacted about my check.{" "}
                    <a href="/privacy/" class="link-u text-xs text-accent-ink">(Privacy notice)</a>
                  </label>
                </div>
                <p id="error-consent" class="field-error hidden" aria-live="polite"></p>
              </div>

              {turnstileSiteKey && (
                <div class="sm:col-span-2">
                  <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
                </div>
              )}

              <div class="flex flex-wrap items-center justify-between gap-4 pt-2 sm:col-span-2">
                <button type="submit" id="submit-btn" class="btn-primary disabled:opacity-70">
                  <span id="btn-text">Send for my free check</span>
                  <span id="btn-spinner" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-paper border-t-transparent"></span>
                </button>
                <p class="text-xs text-meta">A marketing review, not legal advice.</p>
              </div>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

{turnstileSiteKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  // Progressive enhancement & client validation
  import { freeCheckFormSchema } from "../schemas/form";

  // Client-side check uses the same rules (and messages) as the server.
  const clientSchema = freeCheckFormSchema.omit({
    form_rendered_at: true,
    website_url_hp: true,
    "cf-turnstile-response": true
  });

  const showFieldError = (field: string, message: string): void => {
    const el = document.getElementById(`error-${field}`);
    const input = document.getElementById(field);
    if (el) {
      el.textContent = message;
      el.classList.remove("hidden");
    }
    input?.setAttribute("aria-invalid", "true");
  };

  const clearFieldError = (field: string): void => {
    const el = document.getElementById(`error-${field}`);
    if (el) {
      el.textContent = "";
      el.classList.add("hidden");
    }
    document.getElementById(field)?.removeAttribute("aria-invalid");
  };

  const form = document.getElementById("free-check-form") as HTMLFormElement | null;
  const timeField = document.getElementById("form_rendered_at") as HTMLInputElement | null;
  const successBox = document.getElementById("form-success-box");
  const errorBox = document.getElementById("form-error-box");
  const errorMsg = document.getElementById("form-error-msg");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const btnText = document.getElementById("btn-text");
  const btnSpinner = document.getElementById("btn-spinner");

  // Record time when form was loaded in user browser
  if (timeField) {
    timeField.value = Date.now().toString();
  }

  // Check URL query parameters for fallback redirect state
  const params = new URLSearchParams(window.location.search);
  if (params.get("submitted") === "1" && successBox && form) {
    form.classList.add("hidden");
    successBox.classList.remove("hidden");
  }

  if (form) {
    form.addEventListener("input", (e) => {
      const t = e.target as HTMLElement | null;
      if (t?.id && t.getAttribute("aria-invalid") === "true") clearFieldError(t.id);
    });
    form.addEventListener("change", (e) => {
      const t = e.target as HTMLElement | null;
      if (t?.id && t.getAttribute("aria-invalid") === "true") clearFieldError(t.id);
    });
  }

  if (form && submitBtn && btnText && btnSpinner) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Reset error messages
      document.querySelectorAll("[id^='error-']").forEach((el) => {
        el.classList.add("hidden");
        el.textContent = "";
      });
      form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
      if (errorBox) errorBox.classList.add("hidden");

      // Validate every field before sending (same rules as the server)
      const consentBox = form.elements.namedItem("consent") as HTMLInputElement;
      const values: Record<string, unknown> = {};
      new FormData(form).forEach((val, key) => {
        values[key] = val;
      });
      values.consent = consentBox.checked;
      const check = clientSchema.safeParse(values);
      if (!check.success) {
        const seen = new Set<string>();
        check.error.issues.forEach((issue) => {
          const field = String(issue.path[0] ?? "");
          if (!field || seen.has(field)) return;
          seen.add(field);
          showFieldError(field, issue.message);
        });
        if (errorBox) errorBox.classList.remove("hidden");
        // Move focus to the first field that needs attention
        const order = ["name", "organisation", "entityType", "city", "instagram", "website", "whatsapp", "consent"];
        const first = order.find((f) => seen.has(f));
        if (first) {
          const firstEl = document.getElementById(first) as HTMLElement | null;
          firstEl?.focus();
          firstEl?.scrollIntoView({ behavior: "smooth", block: "center" });
        }
        return;
      }

      // Enter loading state
      submitBtn.disabled = true;
      btnText.textContent = "Sending...";
      btnSpinner.classList.remove("hidden");

      const formData = new FormData(form);
      const payload: Record<string, any> = {};
      formData.forEach((val, key) => {
        payload[key] = val;
      });

      try {
        const res = await fetch("/api/free-nmc-check", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (res.ok && data.success) {
          form.reset();
          form.classList.add("hidden");
          if (successBox) {
            successBox.classList.remove("hidden");
            successBox.scrollIntoView({ behavior: "smooth", block: "center" });
          }
        } else {
          // Show error
          if (errorBox && errorMsg) {
            errorMsg.textContent = data.error || "Unable to send your request. Please try again.";
            errorBox.classList.remove("hidden");
          }

          if (data.fields) {
            Object.entries(data.fields).forEach(([field, messages]) => {
              if (Array.isArray(messages) && messages[0]) {
                showFieldError(field, messages[0]);
              }
            });
          }
        }
      } catch (networkErr) {
        if (errorBox && errorMsg) {
          errorMsg.textContent = "Network error. Please try again or message us on WhatsApp.";
          errorBox.classList.remove("hidden");
        }
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = "Send for my free check";
        btnSpinner.classList.add("hidden");
      }
    });
  }
</script>
